Algoritmo "Ex03"
// Professor   : Helida Batista
// Autor(a)    : Abel Benicio
Var
// Seção de Declarações das variáveis 
numero: inteiro
dobro: inteiro
Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
     escreva("digite um número: ")
     leia(numero)
     dobro <- numero * 2
     escreva("o dobro do seu numero é", dobro)

Fimalgoritmo