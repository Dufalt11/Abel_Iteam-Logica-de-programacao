Algoritmo "EX03"
// # Exercício 04 — Área do Triângulo
// Professor: Helida Batista
// Autor(a): Abel Benício
// Data: 04/08/2026

Var
  // Seção de Declarações das variáveis
  // base do triangulo
  base : real
  // altura do triangulo
  altura : real
  // area
  area : real
Inicio
  // Seção de Comandos
  //lendo a base 
  escreval("Digite a base triangulo: ")
  leia(base)
  //lendo a altura 
  escreval("Digite a altura do triangulo: ")
  leia(altura)

  // media aritimetica dos dois numeros
  area <- (base * altura)/2

  escreval("A �rea do trianngulo � ", area)








fimalgoritmo