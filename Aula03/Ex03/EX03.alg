Var
  // SeÃ§Ã£o de DeclaraÃ§Ãµes das variÃ¡veis
  // nÃºmero
  num : real
  // nÃºmero 2
	num2 : real
	// media
  med : real
Inicio
// SeÃ§Ã£o de Comandos
//lendo o primeiro numero
escreval("Digite um número: ")
leia(num)
//lendo o segundo numero
escreval("Digite um número: ")
leia(num2)

// media aritimetica dos dois numeros
med <- (num + num2)/2

escreval("Sua média é ", med)








fimalgoritmo